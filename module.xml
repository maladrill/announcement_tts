<module>
  <rawname>announcementtts</rawname>
  <repo>unsupported</repo>
  <name>Announcements TTS</name>
  <version>17.0.3</version>
  <publisher>SQS Polska</publisher>
  <license>GPLv3+</license>
  <licenselink>http://www.gnu.org/licenses/gpl-3.0.txt</licenselink>
  <changelog>
    Fix transactional TTS saves, audio preview, backups, GraphQL and dialplan input handling.
  </changelog>
  <category>Applications</category>
  <more-info>https://github.com/maladrill/announcement_tts</more-info>
  <description><![CDATA[
   Generates OpenAI TTS announcements and routes calls after playback.
   Requires FFmpeg and a protected /etc/asterisk/openai.key file (mode 0640).
   See README.md for installation and test instructions.]]>
  </description>
  <database/>
  <depends>
    <version>17.0.1</version>
    <module>core ge 17.0.1</module>
  </depends>

  <destinations>
    <!-- nazwa funkcji w functions.inc.php -->
    <announcementtts>announcementtts_destinations</announcementtts>
  </destinations>

  <menuitems>
    <!-- klucz menu: announcementtts -->
    <announcementtts needsenginedb="yes">Announcements TTS</announcementtts>
  </menuitems>

<popovers>
  <announcementtts>
    <display>announcementtts</display>
    <view>form</view>
  </announcementtts>
</popovers>    
   <hooks>
      <dialplan>
        <config>announcementtts_get_config</config>
      </dialplan>
    </hooks>

  <supported>
    <version>17.0</version>
  </supported>
</module>
